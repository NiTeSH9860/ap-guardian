# Nebius Token Factory
# Get these from https://console.nebius.com (Token Factory section)
NEBIUS_API_KEY=your_nebius_token_factory_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model routing — swap these freely, this is the only place model IDs are configured
NEBIUS_EXTRACTION_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_RECONCILIATION_MODEL=nvidia/Nemotron-3-Ultra
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Optional: vendor legitimacy check
TAVILY_API_KEY=your_tavily_api_key

# Vector store
CHROMA_PERSIST_DIR=./data/chroma

# App
APP_ENV=development
LOG_LEVEL=INFO
